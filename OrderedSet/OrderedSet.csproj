<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<VersionPrefix>1.0</VersionPrefix>
		<TargetFrameworks>netstandard2.0;netstandard2.1;net8.0;net9.0;net10.0</TargetFrameworks>
		<LangVersion>latest</LangVersion>
		<RootNamespace>ExtendedCollections</RootNamespace>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- IDE0290: Use primary constructor -->
		<!-- IDE0130: Namespace does not match folder structure -->
		<!-- CS1573: Parameter has no matching param tag -->
		<NoWarn>IDE0290;IDE0130;CS1573</NoWarn>
	</PropertyGroup>

	<PropertyGroup>
		<IsAotCompatible>True</IsAotCompatible>
		<IsTrimmable>True</IsTrimmable>
	</PropertyGroup>

	<PropertyGroup>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageRequireLicenseAcceptance>False</PackageRequireLicenseAcceptance>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<Title>OrderedSet</Title>
		<Description>An ordered version of HashSet.</Description>
		<PackageProjectUrl>https://github.com/Joy-less/OrderedSet</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryUrl>https://github.com/Joy-less/OrderedSet</RepositoryUrl>
		<PackageTags>OrderedSet; ordered set; HashSet; hash set</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<None Include="../README.md">
			<Pack>True</Pack>
			<PackagePath>/</PackagePath>
		</None>
	</ItemGroup>
</Project>